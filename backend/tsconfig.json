{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"],
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "paths": {
      "@vocab/shared": ["../packages/shared/src/index.ts"],
      "@vocab/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "../packages/shared/src/**/*.ts"]
}
