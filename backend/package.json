{
  "name": "@vocab/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply ai_vocab_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai_vocab_db --remote",
    "db:migrations:list": "wrangler d1 migrations list ai_vocab_db",
    "db:seed:local": "wrangler d1 execute ai_vocab_db --local --file=seed/0001_topics_and_fallback.sql",
    "db:seed:remote": "wrangler d1 execute ai_vocab_db --remote --file=seed/0001_topics_and_fallback.sql",
    "seed:settings:local": "node scripts/seed-settings.mjs",
    "seed:settings:remote": "node scripts/seed-settings.mjs --remote"
  },
  "dependencies": {
    "@vocab/shared": "workspace:*",
    "hono": "^4.12.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.7",
    "@cloudflare/workers-types": "^4.20260521.1",
    "@vitest/coverage-istanbul": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "4.1.7",
    "wrangler": "^4.93.0"
  }
}
