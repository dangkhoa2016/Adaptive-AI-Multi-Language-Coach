{
  "name": "@vocab/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply ai_vocab_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai_vocab_db --remote",
    "db:migrations:list": "wrangler d1 migrations list ai_vocab_db",
    "db:seed:local": "wrangler d1 execute ai_vocab_db --local --file=seed/0001_topics_and_fallback.sql",
    "db:seed:remote": "wrangler d1 execute ai_vocab_db --remote --file=seed/0001_topics_and_fallback.sql",
    "seed:settings:local": "node scripts/seed-settings.mjs",
    "seed:settings:remote": "node scripts/seed-settings.mjs --remote",
    "setup:local": "node scripts/setup-local.mjs",
    "test:e2e:server": "node scripts/e2e-server.mjs"
  },
  "dependencies": {
    "@vocab/shared": "workspace:*",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@vitest/coverage-istanbul": "^4.1.12",
    "esbuild": "0.28.2",
    "miniflare": "4.20260625.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.105.0"
  }
}
