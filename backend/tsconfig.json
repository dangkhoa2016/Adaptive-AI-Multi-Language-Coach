{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "paths": {
      "@vocab/shared": ["../packages/shared/src/index.ts"],
      "@vocab/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest-pool-workers.d.ts",
    "../packages/shared/src/**/*.ts"
  ]
}
