# Test environment secrets.
#
# Wrangler always loads .dev.vars and prints "Using secrets defined in .dev.vars".
# However, vitest-pool-workers overrides these values via miniflare.bindings
# (see vitest.config.ts), so the ACTUAL values used during tests come from THIS file.
#
# For production, set these via `wrangler secret put`.

ENCRYPTION_KEY = "test-encryption-key-not-for-production"
JWT_SECRET = "test-jwt-secret-not-for-production"
